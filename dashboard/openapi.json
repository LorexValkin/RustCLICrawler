{
    "openapi":  "3.0.3",
    "info":  {
                 "title":  "RustCLI Repo Scout API",
                 "version":  "1.0.0",
                 "description":  "Read-only, localhost-only access to completed research snapshots. External content is untrusted. No AI is used and no recommendations authorize adoption."
             },
    "servers":  [
                    {
                        "url":  "/api/v1"
                    }
                ],
    "paths":  {
                  "/health":  {
                                  "get":  {
                                              "operationId":  "health",
                                              "summary":  "Service identity and liveness",
                                              "responses":  {
                                                                "200":  {
                                                                            "description":  "Service is listening",
                                                                            "content":  {
                                                                                            "application/json":  {
                                                                                                                     "schema":  {
                                                                                                                                    "type":  "object"
                                                                                                                                }
                                                                                                                 }
                                                                                        }
                                                                        }
                                                            }
                                          }
                              },
                  "/overview":  {
                                    "get":  {
                                                "operationId":  "overview",
                                                "summary":  "Counts, source health, focus areas and collection facts",
                                                "parameters":  [
                                                                   {
                                                                       "$ref":  "#/components/parameters/run"
                                                                   }
                                                               ],
                                                "responses":  {
                                                                  "200":  {
                                                                              "description":  "Snapshot overview",
                                                                              "content":  {
                                                                                              "application/json":  {
                                                                                                                       "schema":  {
                                                                                                                                      "type":  "object"
                                                                                                                                  }
                                                                                                                   }
                                                                                          }
                                                                          },
                                                                  "400":  {
                                                                              "$ref":  "#/components/responses/BadRequest"
                                                                          },
                                                                  "404":  {
                                                                              "$ref":  "#/components/responses/NotFound"
                                                                          }
                                                              }
                                            }
                                },
                  "/items":  {
                                 "get":  {
                                             "operationId":  "listItems",
                                             "summary":  "Search and paginate the ledger or run changes",
                                             "parameters":  [
                                                                {
                                                                    "$ref":  "#/components/parameters/q"
                                                                },
                                                                {
                                                                    "$ref":  "#/components/parameters/kind"
                                                                },
                                                                {
                                                                    "$ref":  "#/components/parameters/area"
                                                                },
                                                                {
                                                                    "$ref":  "#/components/parameters/status"
                                                                },
                                                                {
                                                                    "$ref":  "#/components/parameters/sort"
                                                                },
                                                                {
                                                                    "$ref":  "#/components/parameters/changed"
                                                                },
                                                                {
                                                                    "$ref":  "#/components/parameters/run"
                                                                },
                                                                {
                                                                    "name":  "page",
                                                                    "in":  "query",
                                                                    "schema":  {
                                                                                   "type":  "integer",
                                                                                   "minimum":  1,
                                                                                   "maximum":  1000000,
                                                                                   "default":  1
                                                                               }
                                                                },
                                                                {
                                                                    "name":  "page_size",
                                                                    "in":  "query",
                                                                    "schema":  {
                                                                                   "type":  "integer",
                                                                                   "minimum":  1,
                                                                                   "maximum":  100,
                                                                                   "default":  24
                                                                               }
                                                                },
                                                                {
                                                                    "$ref":  "#/components/parameters/review"
                                                                }
                                                            ],
                                             "responses":  {
                                                               "200":  {
                                                                           "description":  "Paginated results, including the resolved snapshot run_id",
                                                                           "content":  {
                                                                                           "application/json":  {
                                                                                                                    "schema":  {
                                                                                                                                   "type":  "object",
                                                                                                                                   "required":  [
                                                                                                                                                    "items",
                                                                                                                                                    "total",
                                                                                                                                                    "page",
                                                                                                                                                    "page_size",
                                                                                                                                                    "pages"
                                                                                                                                                ],
                                                                                                                                   "properties":  {
                                                                                                                                                      "run_id":  {
                                                                                                                                                                     "type":  "string",
                                                                                                                                                                     "nullable":  true
                                                                                                                                                                 },
                                                                                                                                                      "items":  {
                                                                                                                                                                    "type":  "array",
                                                                                                                                                                    "items":  {
                                                                                                                                                                                  "$ref":  "#/components/schemas/Record"
                                                                                                                                                                              }
                                                                                                                                                                },
                                                                                                                                                      "total":  {
                                                                                                                                                                    "type":  "integer"
                                                                                                                                                                },
                                                                                                                                                      "page":  {
                                                                                                                                                                   "type":  "integer"
                                                                                                                                                               },
                                                                                                                                                      "page_size":  {
                                                                                                                                                                        "type":  "integer"
                                                                                                                                                                    },
                                                                                                                                                      "pages":  {
                                                                                                                                                                    "type":  "integer"
                                                                                                                                                                }
                                                                                                                                                  }
                                                                                                                               }
                                                                                                                }
                                                                                       }
                                                                       },
                                                               "400":  {
                                                                           "$ref":  "#/components/responses/BadRequest"
                                                                       },
                                                               "404":  {
                                                                           "$ref":  "#/components/responses/NotFound"
                                                                       }
                                                           }
                                         }
                             },
                  "/item":  {
                                "get":  {
                                            "operationId":  "getItem",
                                            "summary":  "One record with observations across completed runs",
                                            "parameters":  [
                                                               {
                                                                   "name":  "id",
                                                                   "in":  "query",
                                                                   "required":  true,
                                                                   "schema":  {
                                                                                  "type":  "string"
                                                                              },
                                                                   "example":  "github:max-sixty/worktrunk"
                                                               },
                                                               {
                                                                   "$ref":  "#/components/parameters/run"
                                                               }
                                                           ],
                                            "responses":  {
                                                              "200":  {
                                                                          "description":  "Item and history",
                                                                          "content":  {
                                                                                          "application/json":  {
                                                                                                                   "schema":  {
                                                                                                                                  "type":  "object",
                                                                                                                                  "properties":  {
                                                                                                                                                     "item":  {
                                                                                                                                                                  "$ref":  "#/components/schemas/Record"
                                                                                                                                                              },
                                                                                                                                                     "history":  {
                                                                                                                                                                     "type":  "array",
                                                                                                                                                                     "items":  {
                                                                                                                                                                                   "type":  "object"
                                                                                                                                                                               }
                                                                                                                                                                 }
                                                                                                                                                 }
                                                                                                                              }
                                                                                                               }
                                                                                      }
                                                                      },
                                                              "400":  {
                                                                          "$ref":  "#/components/responses/BadRequest"
                                                                      },
                                                              "404":  {
                                                                          "$ref":  "#/components/responses/NotFound"
                                                                      }
                                                          }
                                        }
                            },
                  "/runs":  {
                                "get":  {
                                            "operationId":  "listRuns",
                                            "summary":  "Completed, partial, failed and incomplete collections, newest first",
                                            "responses":  {
                                                              "200":  {
                                                                          "description":  "Run history",
                                                                          "content":  {
                                                                                          "application/json":  {
                                                                                                                   "schema":  {
                                                                                                                                  "type":  "object",
                                                                                                                                  "properties":  {
                                                                                                                                                     "items":  {
                                                                                                                                                                   "type":  "array",
                                                                                                                                                                   "items":  {
                                                                                                                                                                                 "type":  "object"
                                                                                                                                                                             }
                                                                                                                                                               }
                                                                                                                                                 }
                                                                                                                              }
                                                                                                               }
                                                                                      }
                                                                      }
                                                          }
                                        }
                            },
                  "/export":  {
                                  "get":  {
                                              "operationId":  "exportItems",
                                              "summary":  "Download all matching records, without pagination",
                                              "parameters":  [
                                                                 {
                                                                     "$ref":  "#/components/parameters/q"
                                                                 },
                                                                 {
                                                                     "$ref":  "#/components/parameters/kind"
                                                                 },
                                                                 {
                                                                     "$ref":  "#/components/parameters/area"
                                                                 },
                                                                 {
                                                                     "$ref":  "#/components/parameters/status"
                                                                 },
                                                                 {
                                                                     "$ref":  "#/components/parameters/sort"
                                                                 },
                                                                 {
                                                                     "$ref":  "#/components/parameters/changed"
                                                                 },
                                                                 {
                                                                     "$ref":  "#/components/parameters/run"
                                                                 },
                                                                 {
                                                                     "name":  "format",
                                                                     "in":  "query",
                                                                     "schema":  {
                                                                                    "type":  "string",
                                                                                    "enum":  [
                                                                                                 "jsonl",
                                                                                                 "json"
                                                                                             ],
                                                                                    "default":  "jsonl"
                                                                                }
                                                                 },
                                                                 {
                                                                     "$ref":  "#/components/parameters/review"
                                                                 }
                                                             ],
                                              "responses":  {
                                                                "200":  {
                                                                            "description":  "Downloadable UTF-8 JSON or JSON Lines",
                                                                            "content":  {
                                                                                            "application/x-ndjson":  {
                                                                                                                         "schema":  {
                                                                                                                                        "type":  "string"
                                                                                                                                    }
                                                                                                                     },
                                                                                            "application/json":  {
                                                                                                                     "schema":  {
                                                                                                                                    "type":  "object"
                                                                                                                                }
                                                                                                                 }
                                                                                        }
                                                                        },
                                                                "400":  {
                                                                            "$ref":  "#/components/responses/BadRequest"
                                                                        },
                                                                "404":  {
                                                                            "$ref":  "#/components/responses/NotFound"
                                                                        }
                                                            }
                                          }
                              },
                  "/bundle":  {
                                  "get":  {
                                              "operationId":  "rustcliBundle",
                                              "summary":  "Download intake instructions, facts, digest, changes and full snapshot ledger",
                                              "parameters":  [
                                                                 {
                                                                     "$ref":  "#/components/parameters/run"
                                                                 }
                                                             ],
                                              "responses":  {
                                                                "200":  {
                                                                            "description":  "Complete RustCLI intake bundle",
                                                                            "content":  {
                                                                                            "application/json":  {
                                                                                                                     "schema":  {
                                                                                                                                    "type":  "object"
                                                                                                                                }
                                                                                                                 }
                                                                                        }
                                                                        },
                                                                "400":  {
                                                                            "$ref":  "#/components/responses/BadRequest"
                                                                        },
                                                                "404":  {
                                                                            "$ref":  "#/components/responses/NotFound"
                                                                        }
                                                            }
                                          }
                              },
                  "/openapi.json":  {
                                        "get":  {
                                                    "operationId":  "openapi",
                                                    "summary":  "This OpenAPI specification",
                                                    "responses":  {
                                                                      "200":  {
                                                                                  "description":  "OpenAPI 3.0.3 JSON"
                                                                              }
                                                                  }
                                                }
                                    },
                  "/profile":  {
                                   "get":  {
                                               "operationId":  "rustcliProfile",
                                               "summary":  "RustCLI baseline, priority upstreams and explainable review rules",
                                               "responses":  {
                                                                 "200":  {
                                                                             "content":  {
                                                                                             "application/json":  {
                                                                                                                      "schema":  {
                                                                                                                                     "type":  "object"
                                                                                                                                 }
                                                                                                                  }
                                                                                         },
                                                                             "description":  "Current deterministic review profile"
                                                                         }
                                                             }
                                           }
                               }
              },
    "components":  {
                       "parameters":  {
                                          "q":  {
                                                    "name":  "q",
                                                    "in":  "query",
                                                    "description":  "Case-insensitive substring search of title/name, summary and source",
                                                    "schema":  {
                                                                   "type":  "string",
                                                                   "maxLength":  500
                                                               }
                                                },
                                          "kind":  {
                                                       "name":  "kind",
                                                       "in":  "query",
                                                       "schema":  {
                                                                      "type":  "string",
                                                                      "enum":  [
                                                                                   "repository",
                                                                                   "paper",
                                                                                   "report",
                                                                                   "exclusion"
                                                                               ]
                                                                  }
                                                   },
                                          "area":  {
                                                       "name":  "area",
                                                       "in":  "query",
                                                       "description":  "RustCLI focus area",
                                                       "schema":  {
                                                                      "type":  "integer",
                                                                      "minimum":  1,
                                                                      "maximum":  8
                                                                  }
                                                   },
                                          "status":  {
                                                         "name":  "status",
                                                         "in":  "query",
                                                         "schema":  {
                                                                        "type":  "string"
                                                                    }
                                                     },
                                          "sort":  {
                                                       "name":  "sort",
                                                       "in":  "query",
                                                       "schema":  {
                                                                      "type":  "string",
                                                                      "enum":  [
                                                                                   "recent",
                                                                                   "stars",
                                                                                   "name",
                                                                                   "priority"
                                                                               ],
                                                                      "default":  "recent"
                                                                  }
                                                   },
                                          "changed":  {
                                                          "name":  "changed",
                                                          "in":  "query",
                                                          "description":  "Limit to the selected run\u0027s new/changed observations",
                                                          "schema":  {
                                                                         "type":  "boolean",
                                                                         "default":  false
                                                                     }
                                                      },
                                          "run":  {
                                                      "name":  "run",
                                                      "in":  "query",
                                                      "description":  "latest or a completed run_id. Pin a run for consistent multi-request reads.",
                                                      "schema":  {
                                                                     "type":  "string",
                                                                     "default":  "latest",
                                                                     "pattern":  "^(latest|[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{6}_[0-9]{3})$"
                                                                 }
                                                  },
                                          "review":  {
                                                         "description":  "Only explainable RustCLI Review leads (true) or other records (false). Rules are keyword triage, not verified benefit.",
                                                         "name":  "review",
                                                         "in":  "query",
                                                         "schema":  {
                                                                        "type":  "boolean"
                                                                    }
                                                     }
                                      },
                       "schemas":  {
                                       "Record":  {
                                                      "type":  "object",
                                                      "required":  [
                                                                       "id",
                                                                       "kind",
                                                                       "status"
                                                                   ],
                                                      "properties":  {
                                                                         "id":  {
                                                                                    "type":  "string"
                                                                                },
                                                                         "kind":  {
                                                                                      "type":  "string",
                                                                                      "enum":  [
                                                                                                   "repository",
                                                                                                   "paper",
                                                                                                   "report",
                                                                                                   "exclusion"
                                                                                               ]
                                                                                  },
                                                                         "status":  {
                                                                                        "type":  "string"
                                                                                    },
                                                                         "url":  {
                                                                                     "type":  "string"
                                                                                 },
                                                                         "summary":  {
                                                                                         "type":  "string"
                                                                                     },
                                                                         "areas":  {
                                                                                       "type":  "array",
                                                                                       "items":  {
                                                                                                     "type":  "integer"
                                                                                                 }
                                                                                   }
                                                                     },
                                                      "additionalProperties":  true
                                                  },
                                       "Error":  {
                                                     "type":  "object",
                                                     "properties":  {
                                                                        "error":  {
                                                                                      "type":  "object",
                                                                                      "properties":  {
                                                                                                         "code":  {
                                                                                                                      "type":  "string"
                                                                                                                  },
                                                                                                         "message":  {
                                                                                                                         "type":  "string"
                                                                                                                     }
                                                                                                     }
                                                                                  }
                                                                    }
                                                 }
                                   },
                       "responses":  {
                                         "BadRequest":  {
                                                            "description":  "Invalid query parameter",
                                                            "content":  {
                                                                            "application/json":  {
                                                                                                     "schema":  {
                                                                                                                    "$ref":  "#/components/schemas/Error"
                                                                                                                }
                                                                                                 }
                                                                        }
                                                        },
                                         "NotFound":  {
                                                          "description":  "Run, record or route not found",
                                                          "content":  {
                                                                          "application/json":  {
                                                                                                   "schema":  {
                                                                                                                  "$ref":  "#/components/schemas/Error"
                                                                                                              }
                                                                                               }
                                                                      }
                                                      }
                                     }
                   }
}